<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:local="clr-namespace:BKWitten_App_Frontend.Pages"
             x:Class="BKWitten_App_Frontend.Pages.Teacherprofiles"
             Title="Lehrerprofile"
             Background="Lavender">

    <VerticalStackLayout>

        <CollectionView ItemsSource="{Binding teacherList}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="10" CornerRadius="2" BorderColor="Grey">
                        <VerticalStackLayout>
                            <Label Text="{Binding FirstName}" FontAttributes="Bold"/>
                            <Label Text="{Binding LastName}"/>
                            <Label Text="{Binding Email}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>